main:
  params: [args]
  steps:
    - route_execution:
        switch:
          - condition: $${default(map.get(args, "force_failure"), false) == true}
            next: fail_controlled
          - condition: true
            next: run_detector_query
    - run_detector_query:
        call: googleapis.bigquery.v2.jobs.query
        args:
          projectId: ${project_id}
          body:
            location: US
            useLegacySql: false
            maximumBytesBilled: "10737418240"
            timeoutMs: 60000
            query: ${detector_query_json}
        result: query_result
    - require_completion:
        switch:
          - condition: $${query_result.jobComplete == true}
            next: return_result
    - fail_incomplete:
        raise: "BigQuery detector job did not complete within the bounded workflow call"
    - return_result:
        return:
          jobComplete: $${query_result.jobComplete}
          totalRows: $${default(map.get(query_result, "totalRows"), "0")}
    - fail_controlled:
        raise: "CONTROLLED_TEST_FAILURE: no BigQuery job was submitted"
